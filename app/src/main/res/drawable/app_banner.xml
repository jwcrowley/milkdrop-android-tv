<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner — 320x180dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0D0D1A"
                android:endColor="#1A0A2E"
                android:angle="0" />
        </shape>
    </item>

    <!-- Purple accent bar on left -->
    <item android:right="296dp">
        <shape android:shape="rectangle">
            <solid android:color="#BB86FC" />
        </shape>
    </item>

    <!-- Visualizer bars (decorative) -->
    <item android:left="16dp" android:top="60dp" android:right="270dp" android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#7B2FBE" />
        </shape>
    </item>
    <item android:left="16dp" android:top="50dp" android:right="262dp" android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#9C4FDE" />
        </shape>
    </item>
    <item android:left="16dp" android:top="40dp" android:right="254dp" android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#BB86FC" />
        </shape>
    </item>
    <item android:left="16dp" android:top="30dp" android:right="246dp" android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#E040FB" />
        </shape>
    </item>

</layer-list>
