<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_marginBottom="64dp" />

    <Button
        android:id="@+id/btn_start_visualizer"
        android:layout_width="400dp"
        android:layout_height="80dp"
        android:text="@string/start_visualizer"
        android:textSize="28sp"
        android:focusable="true"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#1E88E5" />

    <Button
        android:id="@+id/btn_browse_presets"
        android:layout_width="400dp"
        android:layout_height="80dp"
        android:text="@string/browse_presets"
        android:textSize="28sp"
        android:focusable="true"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#333333" />

    <Button
        android:id="@+id/btn_settings"
        android:layout_width="400dp"
        android:layout_height="80dp"
        android:text="@string/settings"
        android:textSize="28sp"
        android:focusable="true"
        android:backgroundTint="#333333" />

    <Button
        android:id="@+id/btn_crash_log"
        android:layout_width="400dp"
        android:layout_height="60dp"
        android:text="View Crash Log"
        android:textSize="20sp"
        android:focusable="true"
        android:layout_marginTop="32dp"
        android:backgroundTint="#880000" />

</LinearLayout>
