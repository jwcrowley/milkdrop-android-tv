per_frame_1=rot = 0.02 + 0.01*sin(time*0.3);
per_frame_2=zoom = 1.005 + 0.005*cos(time*0.7);
per_frame_3=wave_r = 0.5 + 0.5*sin(time*0.4);
per_frame_4=wave_g = 0.5 + 0.5*sin(time*0.4 + 2.094);
