per_pixel_1=x2 = x - 0.5;
per_pixel_2=y2 = y - 0.5;
per_pixel_3=r2 = sqrt(x2*x2 + y2*y2);
per_pixel_4=zoom = zoom + 0.002*sin(r2*10.0 - time*2.0);
